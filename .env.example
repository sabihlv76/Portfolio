# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SEO
# Your production domain (no trailing slash) — used for the sitemap, robots.txt,
# canonical URLs, Open Graph tags, and structured data. Falls back to a placeholder
# if unset, so this should be set before deploying to production.
NEXT_PUBLIC_SITE_URL=https://sabihiriho.com

# Google Search Console "HTML tag" verification code (the content value only,
# not the full <meta> tag). Leave unset until you verify ownership — see
# https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
